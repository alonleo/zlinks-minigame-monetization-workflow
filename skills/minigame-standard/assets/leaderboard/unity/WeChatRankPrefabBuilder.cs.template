#if UNITY_EDITOR
using UnityEditor;
using UnityEngine;
using UnityEngine.UI;

public static class WeChatRankPrefabBuilder
{
    private const string OutputPath = "Assets/Resources/StreamingUI/WeChatRankOverlay.prefab";
    private static readonly Color Ink = new Color32(8, 35, 55, 255);
    private static readonly Color Blue = new Color32(12, 177, 235, 255);
    private static readonly Color Gold = new Color32(255, 220, 22, 255);
    private static readonly Color Paper = new Color32(226, 247, 255, 255);
    private static Font font;

    [MenuItem("Tools/Bullet Army/Build WeChat Friend Rank Prefab")]
    public static void Build()
    {
        font = AssetDatabase.LoadAssetAtPath<Font>("Assets/Resources/platformTools/fonts/AlibabaPuHuiTi-3-105-Heavy.otf");
        var titleRibbonSprite = AssetDatabase.LoadAssetAtPath<Sprite>("Assets/Sprite/Title_Ribbon01_Orange.asset");
        var popupBodySprite = AssetDatabase.LoadAssetAtPath<Sprite>("Assets/Sprite/Popup01_Basic_White_Bg.asset");
        var claimButtonSprite = AssetDatabase.LoadAssetAtPath<Sprite>("Assets/Sprite/Button01_l_Sky.asset");
        var goldMedalSprite = AssetDatabase.LoadAssetAtPath<Sprite>("Assets/MiniGameKit/SDK/WeChatTemplate/open-data/images/rank-medal-gold.png");
        var silverMedalSprite = AssetDatabase.LoadAssetAtPath<Sprite>("Assets/MiniGameKit/SDK/WeChatTemplate/open-data/images/rank-medal-silver.png");
        var bronzeMedalSprite = AssetDatabase.LoadAssetAtPath<Sprite>("Assets/MiniGameKit/SDK/WeChatTemplate/open-data/images/rank-medal-bronze.png");
        var avatarPlaceholderSprite = AssetDatabase.LoadAssetAtPath<Sprite>("Assets/MiniGameKit/SDK/WeChatTemplate/open-data/images/rank-avatar-placeholder.png");
        if (titleRibbonSprite == null || popupBodySprite == null || claimButtonSprite == null ||
            goldMedalSprite == null || silverMedalSprite == null || bronzeMedalSprite == null || avatarPlaceholderSprite == null)
        {
            Debug.LogError("WECHAT_RANK_PREFAB_ASSET_MISSING");
            return;
        }

        var root = new GameObject("WeChatRankOverlay", typeof(RectTransform), typeof(Canvas), typeof(CanvasScaler),
            typeof(GraphicRaycaster), typeof(WeChatRankOverlay));
        var rootRect = root.GetComponent<RectTransform>();
        rootRect.localScale = Vector3.one;
        rootRect.anchorMin = Vector2.zero;
        rootRect.anchorMax = Vector2.one;
        rootRect.offsetMin = rootRect.offsetMax = Vector2.zero;
        var canvas = root.GetComponent<Canvas>();
        canvas.renderMode = RenderMode.ScreenSpaceOverlay;
        canvas.sortingOrder = 32000;
        var scaler = root.GetComponent<CanvasScaler>();
        scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
        scaler.referenceResolution = new Vector2(750f, 1334f);
        scaler.screenMatchMode = CanvasScaler.ScreenMatchMode.MatchWidthOrHeight;
        scaler.matchWidthOrHeight = 0.5f;

        CreateRounded(root.transform, "Shade", new Color(0f, 0.08f, 0.13f, 0.76f), 0f, Vector2.zero, Vector2.one);

        // Reuse the exact reward-popup shell from reference image 2. Keep it compact and
        // leave space underneath for the original plain-text dismiss control.
        var panel = CreateImage(root.transform, "Panel", popupBodySprite,
            new Color(0f, 0.6784314f, 0.99607843f, 1f), Image.Type.Sliced,
            new Vector2(0.085f, 0.255f), new Vector2(0.915f, 0.745f));

        // Reuse the game's three-part title ribbon; only the text is leaderboard-specific.
        var titleRibbon = CreateImage(root.transform, "TitleRibbon", titleRibbonSprite, Gold, Image.Type.Sliced,
            new Vector2(0.055f, 0.705f), new Vector2(0.945f, 0.795f));
        var title = CreateText(titleRibbon.transform, "Title", "排行榜", 48, Color.white, FontStyle.Bold);
        // The Sprite's central title board sits slightly above the full ribbon bounds because
        // the folded tails extend lower. Center against that board instead of the whole texture.
        SetAnchors(title.rectTransform, new Vector2(0.25f, 0.14f), new Vector2(0.75f, 0.96f));

        var caption = CreateText(panel.transform, "Caption", "好友已通关数", 29, Color.white, FontStyle.Bold);
        SetAnchors(caption.rectTransform, new Vector2(0.16f, 0.82f), new Vector2(0.84f, 0.91f));

        var listInk = CreateRounded(panel.transform, "ListInk", Ink, 20f, new Vector2(0.065f, 0.25f), new Vector2(0.935f, 0.80f));
        var listPaper = CreateInset(listInk.transform, "ListPaper", Paper, 16f, 4f);
        var preview = CreateEditorPreview(listPaper.transform, goldMedalSprite, silverMedalSprite,
            bronzeMedalSprite, avatarPlaceholderSprite);
        var rankObject = new GameObject("FriendRankData", typeof(RectTransform), typeof(CanvasRenderer), typeof(RawImage));
        rankObject.transform.SetParent(listPaper.transform, false);
        var rankRect = rankObject.GetComponent<RectTransform>();
        SetStretch(rankRect, 8f);
        rankRect.localEulerAngles = new Vector3(180f, 0f, 0f);
        var rawImage = rankObject.GetComponent<RawImage>();
        rawImage.color = Color.white;
        rawImage.raycastTarget = false;

        // Reuse the exact blue claim button Sprite from reference image 2.
        var share = CreateImage(panel.transform, "Share", claimButtonSprite, Color.white, Image.Type.Sliced,
            new Vector2(0.27f, 0.055f), new Vector2(0.73f, 0.205f));
        var shareButton = share.gameObject.AddComponent<Button>();
        shareButton.targetGraphic = share;
        CreateText(share.transform, "Label", "分享好友排行榜", 28, Color.white, FontStyle.Bold);

        // The reference popup has no top-right close icon. Its plain "暂不需要" action
        // sits below the shell; the leaderboard uses that same control with text changed to "关闭".
        var closeHitArea = new GameObject("Close", typeof(RectTransform), typeof(CanvasRenderer), typeof(Image), typeof(Button));
        closeHitArea.transform.SetParent(root.transform, false);
        var closeRect = closeHitArea.GetComponent<RectTransform>();
        SetAnchors(closeRect, new Vector2(0.29f, 0.195f), new Vector2(0.71f, 0.25f));
        var closeGraphic = closeHitArea.GetComponent<Image>();
        closeGraphic.color = new Color(1f, 1f, 1f, 0f);
        var closeButton = closeHitArea.GetComponent<Button>();
        closeButton.targetGraphic = closeGraphic;
        CreateText(closeHitArea.transform, "Label", "关闭", 35, Color.white, FontStyle.Bold);

        var overlay = root.GetComponent<WeChatRankOverlay>();
        var serialized = new SerializedObject(overlay);
        serialized.FindProperty("rankImage").objectReferenceValue = rawImage;
        serialized.FindProperty("closeButton").objectReferenceValue = closeButton;
        serialized.FindProperty("shareButton").objectReferenceValue = shareButton;
        serialized.FindProperty("editorPreview").objectReferenceValue = preview;
        serialized.ApplyModifiedPropertiesWithoutUndo();

        // CanvasScaler can temporarily drive the root scale to zero in headless editor sessions.
        // Persist a visible prefab regardless of the current editor display state.
        rootRect.localScale = Vector3.one;
        PrefabUtility.SaveAsPrefabAsset(root, OutputPath);
        var savedRoot = AssetDatabase.LoadAssetAtPath<GameObject>(OutputPath);
        if (savedRoot != null)
        {
            var savedRect = new SerializedObject(savedRoot.GetComponent<RectTransform>());
            savedRect.FindProperty("m_LocalScale").vector3Value = Vector3.one;
            savedRect.ApplyModifiedPropertiesWithoutUndo();
        }
        Object.DestroyImmediate(root);
        AssetDatabase.SaveAssets();
        AssetDatabase.Refresh();
        Debug.Log("WECHAT_RANK_PREFAB_BUILT " + OutputPath);
    }

    public static void BuildBatch() { Build(); }

    private static Image CreateImage(Transform parent, string name, Sprite sprite, Color color, Image.Type type,
        Vector2 min, Vector2 max)
    {
        var go = new GameObject(name, typeof(RectTransform), typeof(CanvasRenderer), typeof(Image));
        go.transform.SetParent(parent, false);
        var rect = go.GetComponent<RectTransform>();
        SetAnchors(rect, min, max);
        var image = go.GetComponent<Image>();
        image.sprite = sprite;
        image.color = color;
        image.type = type;
        return image;
    }

    private static WeChatRankRoundedGraphic CreateRounded(Transform parent, string name, Color color, float radius, Vector2 min, Vector2 max)
    {
        var go = new GameObject(name, typeof(RectTransform), typeof(CanvasRenderer), typeof(WeChatRankRoundedGraphic));
        go.transform.SetParent(parent, false);
        var rect = go.GetComponent<RectTransform>();
        rect.anchorMin = min;
        rect.anchorMax = max;
        rect.offsetMin = rect.offsetMax = Vector2.zero;
        var graphic = go.GetComponent<WeChatRankRoundedGraphic>();
        graphic.color = color;
        graphic.Radius = radius;
        return graphic;
    }

    private static WeChatRankRoundedGraphic CreateInset(Transform parent, string name, Color color, float radius, float inset)
    {
        var graphic = CreateRounded(parent, name, color, radius, Vector2.zero, Vector2.one);
        SetStretch(graphic.rectTransform, inset);
        return graphic;
    }

    private static WeChatRankRoundedGraphic CreateFixedRounded(Transform parent, string name, Color color, float radius,
        Vector2 anchor, Vector2 size)
    {
        var graphic = CreateRounded(parent, name, color, radius, anchor, anchor);
        graphic.rectTransform.sizeDelta = size;
        return graphic;
    }

    private static WeChatRankRoundedGraphic CreateTrophy(Transform parent, Vector2 anchor)
    {
        var root = CreateFixedRounded(parent, "Trophy", Color.clear, 0f, anchor, new Vector2(118f, 104f));
        root.raycastTarget = false;
        var leftHandle = CreateFixedRounded(root.transform, "LeftHandle", Gold, 12f, new Vector2(0.17f, 0.66f), new Vector2(30f, 42f));
        var rightHandle = CreateFixedRounded(root.transform, "RightHandle", Gold, 12f, new Vector2(0.83f, 0.66f), new Vector2(30f, 42f));
        var cup = CreateFixedRounded(root.transform, "Cup", new Color32(255, 188, 15, 255), 15f, new Vector2(0.5f, 0.67f), new Vector2(72f, 54f));
        var stem = CreateFixedRounded(root.transform, "Stem", new Color32(255, 188, 15, 255), 4f, new Vector2(0.5f, 0.32f), new Vector2(14f, 30f));
        var baseGraphic = CreateFixedRounded(root.transform, "Base", Gold, 6f, new Vector2(0.5f, 0.16f), new Vector2(58f, 14f));
        leftHandle.raycastTarget = rightHandle.raycastTarget = cup.raycastTarget = stem.raycastTarget = baseGraphic.raycastTarget = false;
        return root;
    }

    private static GameObject CreateEditorPreview(Transform parent, Sprite goldMedal, Sprite silverMedal,
        Sprite bronzeMedal, Sprite avatarPlaceholder)
    {
        var root = new GameObject("EditorPreview", typeof(RectTransform));
        root.transform.SetParent(parent, false);
        SetStretch(root.GetComponent<RectTransform>(), 8f);

        CreatePreviewText(root.transform, "HeaderRank", "名次", new Vector2(0.01f, 0.86f), new Vector2(0.17f, 0.99f), 22, Ink);
        CreatePreviewText(root.transform, "HeaderName", "昵称", new Vector2(0.18f, 0.86f), new Vector2(0.70f, 0.99f), 22, Ink);
        CreatePreviewText(root.transform, "HeaderScore", "通关数", new Vector2(0.70f, 0.86f), new Vector2(0.99f, 0.99f), 22, Ink);
        CreatePreviewRow(root.transform, "First", "1", "快乐玩家", "128", 0.65f, new Color32(255, 241, 168, 255), goldMedal, avatarPlaceholder);
        CreatePreviewRow(root.transform, "Second", "2", "小太阳", "96", 0.44f, new Color32(248, 252, 255, 255), silverMedal, avatarPlaceholder);
        CreatePreviewRow(root.transform, "Third", "3", "小橙子", "72", 0.23f, new Color32(248, 252, 255, 255), bronzeMedal, avatarPlaceholder);
        CreatePreviewRow(root.transform, "Self", "8", "我", "40", 0.02f, new Color32(207, 238, 255, 255), null, avatarPlaceholder);
        return root;
    }

    private static void CreatePreviewRow(Transform parent, string name, string rank, string nickname, string score,
        float bottom, Color background, Sprite medal, Sprite avatarPlaceholder)
    {
        var row = CreateRounded(parent, name, background, 11f, new Vector2(0.015f, bottom), new Vector2(0.985f, bottom + 0.19f));
        row.raycastTarget = false;
        if (medal != null)
            CreateFixedImage(row.transform, "RankMedal", medal, new Vector2(0.07f, 0.5f), new Vector2(46f, 46f));
        else
            CreatePreviewText(row.transform, "Rank", rank, new Vector2(0f, 0f), new Vector2(0.14f, 1f), 25, Ink);
        CreateFixedImage(row.transform, "Avatar", avatarPlaceholder, new Vector2(0.23f, 0.5f), new Vector2(44f, 44f));
        CreatePreviewText(row.transform, "Name", nickname, new Vector2(0.31f, 0f), new Vector2(0.72f, 1f), 22, Ink);
        CreatePreviewText(row.transform, "Score", "★ " + score, new Vector2(0.72f, 0f), new Vector2(0.99f, 1f), 22, Ink);
    }

    private static Image CreateFixedImage(Transform parent, string name, Sprite sprite, Vector2 anchor, Vector2 size)
    {
        var image = CreateImage(parent, name, sprite, Color.white, Image.Type.Simple, anchor, anchor);
        image.rectTransform.sizeDelta = size;
        image.preserveAspect = true;
        image.raycastTarget = false;
        return image;
    }

    private static Text CreatePreviewText(Transform parent, string name, string value, Vector2 min, Vector2 max, int size, Color color)
    {
        var text = CreateText(parent, name, value, size, color, FontStyle.Bold);
        SetAnchors(text.rectTransform, min, max);
        return text;
    }

    private static Text CreateText(Transform parent, string name, string value, int size, Color color, FontStyle style)
    {
        var go = new GameObject(name, typeof(RectTransform), typeof(CanvasRenderer), typeof(Text), typeof(Outline));
        go.transform.SetParent(parent, false);
        var rect = go.GetComponent<RectTransform>();
        rect.anchorMin = Vector2.zero;
        rect.anchorMax = Vector2.one;
        rect.offsetMin = rect.offsetMax = Vector2.zero;
        var text = go.GetComponent<Text>();
        text.text = value;
        text.font = font;
        text.fontSize = size;
        text.fontStyle = style;
        text.alignment = TextAnchor.MiddleCenter;
        text.color = color;
        text.resizeTextForBestFit = true;
        text.resizeTextMinSize = Mathf.Max(16, size / 2);
        text.resizeTextMaxSize = size;
        text.raycastTarget = false;
        var outline = go.GetComponent<Outline>();
        outline.enabled = color.grayscale > 0.65f;
        outline.effectColor = new Color(0.02f, 0.1f, 0.16f, 0.9f);
        outline.effectDistance = new Vector2(1.2f, -1.2f);
        return text;
    }

    private static void CreateStroke(Transform parent, float rotation)
    {
        var stroke = CreateRounded(parent, "Stroke", Color.white, 4f, new Vector2(0.5f, 0.5f), new Vector2(0.5f, 0.5f));
        stroke.rectTransform.sizeDelta = new Vector2(38f, 7f);
        stroke.rectTransform.localEulerAngles = new Vector3(0f, 0f, rotation);
        stroke.raycastTarget = false;
    }

    private static void SetStretch(RectTransform rect, float inset)
    {
        rect.anchorMin = Vector2.zero;
        rect.anchorMax = Vector2.one;
        rect.offsetMin = new Vector2(inset, inset);
        rect.offsetMax = new Vector2(-inset, -inset);
    }

    private static void SetAnchors(RectTransform rect, Vector2 min, Vector2 max)
    {
        rect.anchorMin = min;
        rect.anchorMax = max;
        rect.offsetMin = rect.offsetMax = Vector2.zero;
    }
}
#endif
