using UnityEngine;
using UnityEngine.UI;

/// <summary>Small texture-free rounded rectangle used by the favorite guide prefab.</summary>
[RequireComponent(typeof(CanvasRenderer))]
public sealed class FavoriteGuideRoundedGraphic : MaskableGraphic
{
    [SerializeField, Min(0f)] private float radius = 24f;
    [SerializeField, Range(2, 16)] private int cornerSegments = 8;

    public float Radius
    {
        get => radius;
        set
        {
            radius = Mathf.Max(0f, value);
            SetVerticesDirty();
        }
    }

    protected override void OnPopulateMesh(VertexHelper vh)
    {
        vh.Clear();
        Rect rect = GetPixelAdjustedRect();
        if (rect.width <= 0f || rect.height <= 0f) return;

        float resolvedRadius = Mathf.Min(radius, Mathf.Min(rect.width, rect.height) * 0.5f);
        int segments = Mathf.Max(2, cornerSegments);
        vh.AddVert(rect.center, color, new Vector2(0.5f, 0.5f));

        AddCorner(vh, new Vector2(rect.xMax - resolvedRadius, rect.yMin + resolvedRadius), resolvedRadius, -90f, 0f, segments, rect);
        AddCorner(vh, new Vector2(rect.xMax - resolvedRadius, rect.yMax - resolvedRadius), resolvedRadius, 0f, 90f, segments, rect);
        AddCorner(vh, new Vector2(rect.xMin + resolvedRadius, rect.yMax - resolvedRadius), resolvedRadius, 90f, 180f, segments, rect);
        AddCorner(vh, new Vector2(rect.xMin + resolvedRadius, rect.yMin + resolvedRadius), resolvedRadius, 180f, 270f, segments, rect);

        int perimeter = vh.currentVertCount - 1;
        for (int index = 0; index < perimeter; index++)
            vh.AddTriangle(0, index + 1, index + 1 == perimeter ? 1 : index + 2);
    }

    private void AddCorner(VertexHelper vh, Vector2 center, float resolvedRadius, float from, float to, int segments, Rect rect)
    {
        for (int index = 0; index <= segments; index++)
        {
            float angle = Mathf.Lerp(from, to, index / (float)segments) * Mathf.Deg2Rad;
            Vector2 point = center + new Vector2(Mathf.Cos(angle), Mathf.Sin(angle)) * resolvedRadius;
            Vector2 uv = new Vector2(
                Mathf.InverseLerp(rect.xMin, rect.xMax, point.x),
                Mathf.InverseLerp(rect.yMin, rect.yMax, point.y));
            vh.AddVert(point, color, uv);
        }
    }
}

